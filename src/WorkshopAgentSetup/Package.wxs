<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Workshop Command Center Agent"
      Manufacturer="Workshop Link"
      Version="1.0.142.0"
      UpgradeCode="7E4B9C2A-1D6F-4A83-9C55-8F2E6B0D4A17"
      Scope="perMachine"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Workshop Command Center Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="..\..\setup\license.rtf" />
    <Property Id="LicenseAccepted" Value="1" />
    <Property Id="WLINKPASS" Secure="yes" Hidden="yes" />
    <Property Id="WLINKCONFIRM" Secure="yes" Hidden="yes" />
    <Property Id="WLINKPLACE" Value="lan" />
    <Property Id="WLINKGROUP" Secure="yes" />
    <Property Id="WLINKPASSERROR" Secure="yes" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Workshop Link Agent 1.0.142 is installed. The desktop shortcut opens the status page. A green tick means the agent is running." />
    <InstallUISequence>
      <Show Dialog="WorkshopSetupDlg" Before="ExecuteAction" Condition="NOT REMOVE AND NOT WIX_UPGRADE_DETECTED" />
    </InstallUISequence>
    <Feature Id="Main" Title="Workshop Command Center Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>
    <InstallExecuteSequence>
      <Custom Action="StopOldAgent" Before="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="PrepareAgentConfig" Before="WriteAgentConfig" Condition="NOT REMOVE AND (NOT WIX_UPGRADE_DETECTED OR WLINKGROUP &lt;&gt; &quot;&quot;)" />
      <Custom Action="WriteAgentConfig" After="InstallFiles" Condition="NOT REMOVE AND (NOT WIX_UPGRADE_DETECTED OR WLINKGROUP &lt;&gt; &quot;&quot;)" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Workshop Command Center Agent" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Component Id="AgentExe" Bitness="always64">
        <File Id="WorkshopAgentExe" Source="..\..\publish\WorkshopAgent\WorkshopAgent.exe" KeyPath="yes">
          <Shortcut Id="AgentDesktop" Directory="DesktopFolder" Name="Workshop Link Agent" Arguments="--status" WorkingDirectory="INSTALLFOLDER" Description="Workshop Link remote maintenance" />
        </File>
        <ServiceInstall
            Id="WorkshopLinkInstall"
            Name="WorkshopCommandCenterAgent"
            DisplayName="Workshop Link Agent"
            Description="Announces this PC and accepts command center actions after the installer password."
            Type="ownProcess"
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal"
            Arguments="--service"
            Vital="yes" />
        <ServiceControl
            Id="WorkshopLinkControl"
            Name="WorkshopCommandCenterAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
        <util:ServiceConfig
            ServiceName="WorkshopCommandCenterAgent"
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="5"
            ResetPeriodInDays="1" />
      </Component>
      <Component Id="AgentAv1" Bitness="always64">
        <File Id="AgentAv1Dll" Source="..\..\publish\WorkshopAgent\wlinkav1.dll" KeyPath="yes" />
      </Component>
      <Component Id="AgentAv1Notice" Bitness="always64">
        <File Id="AgentAv1NoticeFile" Source="..\..\native\NOTICE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Binary Id="PasswordCa" SourceFile="..\WorkshopPasswordCa\bin\x64\Release\net472\WorkshopPasswordCa.CA.dll" />
    <CustomAction
        Id="CheckPassword"
        BinaryRef="PasswordCa"
        DllEntry="CheckPassword"
        Execute="immediate"
        Return="check" />
    <CustomAction
        Id="PrepareAgentConfig"
        BinaryRef="PasswordCa"
        DllEntry="PrepareAgentConfig"
        Execute="immediate"
        Return="check" />
    <CustomAction
        Id="StopOldAgent"
        BinaryRef="PasswordCa"
        DllEntry="StopOldAgent"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <CustomAction
        Id="WriteAgentConfig"
        BinaryRef="PasswordCa"
        DllEntry="WriteAgentConfig"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <UI>
      <Dialog Id="WorkshopSetupDlg" Width="370" Height="318" Title="Workshop Link Agent 1.0.142">
        <Control Id="Title" Type="Text" X="15" Y="12" Width="340" Height="18" Text="{\WixUI_Font_Title}Command center password" />
        <Control Id="Body" Type="Text" X="15" Y="36" Width="340" Height="36" Text="This password is only for the command center. It is not a Windows logon. Use at least 12 characters, with upper-case, lower-case, and a number or symbol." />
        <Control Id="PassLabel" Type="Text" X="15" Y="80" Width="90" Height="14" Text="Password" />
        <Control Id="Password" Type="Edit" X="110" Y="78" Width="230" Height="18" Password="yes" Property="WLINKPASS" />
        <Control Id="ConfirmLabel" Type="Text" X="15" Y="106" Width="90" Height="14" Text="Confirm" />
        <Control Id="Confirm" Type="Edit" X="110" Y="104" Width="230" Height="18" Password="yes" Property="WLINKCONFIRM" />
        <Control Id="Place" Type="RadioButtonGroup" X="15" Y="140" Width="340" Height="48" Property="WLINKPLACE">
          <RadioButtonGroup Property="WLINKPLACE">
            <RadioButton Value="lan" X="0" Y="0" Width="330" Height="16" Text="This PC is on the local network." />
            <RadioButton Value="offsite" X="0" Y="20" Width="330" Height="16" Text="This PC is offsite. Connect it through Cloudflare." />
          </RadioButtonGroup>
        </Control>
        <Control Id="GroupLabel" Type="Text" X="15" Y="196" Width="340" Height="28" Text="Group key, optional. Looks like ABCD-EFGH. Local and offsite both use it. Leave blank if this PC has no group." />
        <Control Id="GroupKey" Type="Edit" X="15" Y="226" Width="325" Height="18" Property="WLINKGROUP" />
        <Control Id="Next" Type="PushButton" X="236" Y="288" Width="56" Height="17" Text="&amp;Next" Default="yes">
          <Publish Event="SpawnDialog" Value="PasswordProblemDlg" Condition="NOT (WLINKPASS = WLINKCONFIRM) OR WLINKPASS = &quot;&quot;" />
          <Publish Event="DoAction" Value="CheckPassword" Condition="WLINKPASS = WLINKCONFIRM AND WLINKPASS &lt;&gt; &quot;&quot;" />
          <Publish Event="SpawnDialog" Value="PasswordWeakDlg" Condition="WLINKPASS = WLINKCONFIRM AND WLINKPASS &lt;&gt; &quot;&quot; AND WLINKPASSERROR &lt;&gt; &quot;&quot;" />
          <Publish Event="EndDialog" Value="Return" Condition="WLINKPASS = WLINKCONFIRM AND WLINKPASS &lt;&gt; &quot;&quot; AND WLINKPASSERROR = &quot;&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="288" Width="56" Height="17" Text="Cancel" Cancel="yes">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="PasswordWeakDlg" Width="280" Height="110" Title="Workshop Link Agent">
        <Control Id="Text" Type="Text" X="15" Y="15" Width="250" Height="48" Text="[WLINKPASSERROR]" />
        <Control Id="Ok" Type="PushButton" X="112" Y="78" Width="56" Height="17" Text="OK" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="PasswordProblemDlg" Width="280" Height="95" Title="Workshop Link Agent">
        <Control Id="Text" Type="Text" X="15" Y="15" Width="250" Height="36" Text="Type the same command center password in both boxes before continuing." />
        <Control Id="Ok" Type="PushButton" X="112" Y="62" Width="56" Height="17" Text="OK" Default="yes" Cancel="yes">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
