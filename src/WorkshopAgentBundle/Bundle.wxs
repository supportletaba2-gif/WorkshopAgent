<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="Workshop Command Center Agent"
      Manufacturer="Workshop Link"
      Version="1.0.134.0"
      UpgradeCode="B6D41F08-2A77-4E5C-9C13-70A8E2F45D61">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication LicenseUrl="" Theme="hyperlinkLicense" ShowVersion="yes" SuppressOptionsUI="yes" />
    </BootstrapperApplication>
    <util:RegistrySearch
        Id="DesktopRuntime831"
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Value="8.0.31"
        Result="exists"
        Variable="NetDesktopInstalled"
        Bitness="always64" />
    <Chain>
      <ExePackage
          Id="DotNetDesktopRuntime"
          DisplayName="Microsoft Windows Desktop Runtime 8.0.31"
          SourceFile="..\..\redist\windowsdesktop-runtime-8.0.31-win-x64.exe"
          DetectCondition="NetDesktopInstalled"
          InstallArguments="/install /quiet /norestart"
          Permanent="yes"
          PerMachine="yes"
          Vital="yes"
          Compressed="yes" />
      <MsiPackage Id="Agent" SourceFile="..\WorkshopAgentSetup\bin\x64\Release\WorkshopAgent.msi" bal:DisplayInternalUICondition="0" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
