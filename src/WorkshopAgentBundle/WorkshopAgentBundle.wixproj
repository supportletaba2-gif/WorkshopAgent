<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>WorkshopAgentSetup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
  <Target Name="CopyToPublishSetup" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)WorkshopAgentSetup.exe" DestinationFolder="$(MSBuildThisFileDirectory)..\..\publish\setup\Agent\" SkipUnchangedFiles="false" />
  </Target>
</Project>
