<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.138</Version>
    <ApplicationIcon>workshop-link.ico</ApplicationIcon>
    <AssemblyName>WorkshopAgent</AssemblyName>
    <RootNamespace>WorkshopAgent</RootNamespace>
    <Product>Workshop Link Agent</Product>
    <Company>Workshop Link</Company>
    <Description>Prepares a workshop PC and announces it on the local network.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkshopLink.Protocol\WorkshopLink.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\native\win-x64\wlinkav1.dll" Link="wlinkav1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
